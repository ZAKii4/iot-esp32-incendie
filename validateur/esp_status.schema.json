{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsi.ma/iot/esp_status.schema.json",
  "title": "Status d'un ESP32 (modele impose par G. Menez) - version durcie",
  "description": "Payload JSON envoyee par l'ESP32 a la station de supervision. Tout ce qui n'est pas explicitement autorise est refuse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "location", "regul", "info", "net", "reporthost"],

  "$defs": {
    "texte": {
      "description": "Texte sur liste blanche : lettres (accents latins compris), chiffres, espace et . , ' & ( ) / # : _ - ; commence par une lettre ou un chiffre (bloque les formules CSV = + - @), ne finit pas par un espace. Interdit < > { } \" ` ; | = (HTML, gabarits, injections).",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9À-ÖØ-öø-ſ](?:[A-Za-z0-9À-ÖØ-öø-ſ .,'&()/#:_-]*[A-Za-z0-9À-ÖØ-öø-ſ.)])?$"
    },
    "onoff": { "type": "string", "enum": ["ON", "OFF"] },
    "ipv4": {
      "type": "string",
      "maxLength": 15,
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "temperature": { "type": "number", "minimum": -55, "maximum": 125 }
  },

  "properties": {

    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "light", "regul", "fire", "heat", "cold", "fanspeed"],
      "properties": {
        "temperature": {
          "description": "Plage du DS18B20 ; null si le capteur est absent",
          "anyOf": [ { "$ref": "#/$defs/temperature" }, { "type": "null" } ]
        },
        "light":    { "type": "integer", "minimum": 0, "maximum": 4095 },
        "regul":    { "type": "string", "enum": ["RUNNING", "HALT"] },
        "fire":     { "type": "boolean" },
        "heat":     { "$ref": "#/$defs/onoff" },
        "cold":     { "$ref": "#/$defs/onoff" },
        "fanspeed": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "gps", "address"],
      "properties": {
        "room":    { "$ref": "#/$defs/texte", "maxLength": 64 },
        "address": { "$ref": "#/$defs/texte", "maxLength": 128 },
        "gps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90,  "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },

    "regul": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lt", "ht"],
      "properties": {
        "lt": { "$ref": "#/$defs/temperature" },
        "ht": { "$ref": "#/$defs/temperature" }
      }
    },

    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ident", "user", "loc"],
      "properties": {
        "ident": { "$ref": "#/$defs/texte", "maxLength": 32 },
        "user":  { "$ref": "#/$defs/texte", "maxLength": 64 },
        "loc":   { "$ref": "#/$defs/texte", "maxLength": 64 }
      }
    },

    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uptime", "ssid", "mac", "ip"],
      "properties": {
        "uptime": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{1,10}$" },
        "ssid":   { "$ref": "#/$defs/texte", "maxLength": 32 },
        "mac":    { "type": "string", "maxLength": 17, "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$" },
        "ip":     { "$ref": "#/$defs/ipv4" }
      }
    },

    "reporthost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ip", "target_port", "sp"],
      "properties": {
        "target_ip":   { "$ref": "#/$defs/ipv4" },
        "target_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sp":          { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
