    {
        "id": "0659c7d7e4ed1e33",
        "type": "function",
        "z": "7ff6eee704aae8ae",
        "name": "Simuler un ESP32",
        "func": "// Fabrique une ligne JSON IDENTIQUE a celle de l'ESP (une CHAINE, comme sur le port serie)\nlet k = (context.get(\"k\") || 0) + 1;\ncontext.set(\"k\", k);\nconst t   = Math.round((25 + 4 * Math.sin(k / 6)) * 100) / 100;\nconst feu = (k % 60) > 50;                       // un \"feu\" de 20 s par 2 minutes\nconst lum = feu ? 3900 : Math.round(1500 + 300 * Math.random());\nconst lt = 22, ht = 26;\nconst chaud = t > ht && !feu, froid = t < lt && !feu;\nconst fan = chaud ? Math.min(100, Math.round(40 + 60 * (t - ht) / 4)) : 0;\nconst status = {\n  status: {temperature: t, light: lum, regul: feu ? \"HALT\" : \"RUNNING\", fire: feu,\n           heat: froid ? \"ON\" : \"OFF\", cold: chaud ? \"ON\" : \"OFF\", fanspeed: fan},\n  location: {room: \"Salle TP IoT\", gps: {lat: 33.5731, lon: -7.5898},\n             address: \"EMSI Casablanca - site CFC\"},\n  regul: {lt: lt, ht: ht},\n  info: {ident: \"ESP32 SIMUL\", user: \"Malak Zaoufy & Zakaria Khamlich\", loc: \"EMSI Casablanca\"},\n  net: {uptime: String(2 * k), ssid: \"NOP\", mac: \"00:00:00:00:00:00\", ip: \"0.0.0.0\"},\n  reporthost: {target_ip: \"127.0.0.1\", target_port: 1880, sp: 2}\n};\nmsg.payload = JSON.stringify(status);          // SERIALISATION : objet -> chaine\n\n// Comme l'ESP : une ligne {\"alerte\":...} seulement quand l'etat de feu CHANGE\nif (feu !== (context.get(\"feu\") || false)) {   // au demarrage : pas de feu\n    context.set(\"feu\", feu);\n    node.send({payload: JSON.stringify({alerte: feu ? \"FEU\" : \"NORMAL\", lum: lum})});\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 320,
        "wires": [
            [
                "2bf959e3d78dc530"
            ]
        ]
    },
