    {
        "id": "2bf959e3d78dc530",
        "type": "function",
        "z": "7ff6eee704aae8ae",
        "name": "Filtrer + parser JSON",
        "func": "// L'ESP envoie aussi du texte pour l'humain : on ne garde que les lignes JSON.\nconst ligne = String(msg.payload).trim();\nif (!ligne.startsWith(\"{\")) return null;\n\nlet obj;\ntry {\n    obj = JSON.parse(ligne);          // DESERIALISATION : chaine -> objet\n} catch (e) {\n    node.warn(\"Ligne JSON invalide ignoree : \" + ligne);\n    return null;\n}\n\nconst heure = new Date().toLocaleTimeString();\nif (obj.status) {                    // status complet -> sortie 1\n    node.status({fill: \"green\", shape: \"dot\", text: \"status recu a \" + heure});\n    return [{payload: obj, recu: heure}, null];\n}\nif (obj.alerte) {                    // evenement {\"alerte\":...} -> sortie 2\n    return [null, {payload: obj}];\n}\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 260,
        "wires": [
