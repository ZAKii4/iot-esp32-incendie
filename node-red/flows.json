    {
        "id": "b3bbc0230a4847d5",
        "type": "function",
        "z": "7ff6eee704aae8ae",
        "name": "Formatting for csv",
        "func": "// Une ligne CSV par status : date;temperature;light;regul;fire;heat;cold;fanspeed\nconst s = msg.payload.status;\nmsg.payload = [new Date().toISOString(), s.temperature, s.light, s.regul,\n               s.fire, s.heat, s.cold, s.fanspeed].join(\";\");\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 160,
        "wires": [
            [
                "7a95c1474bfb8889"
            ]
        ]
    },
